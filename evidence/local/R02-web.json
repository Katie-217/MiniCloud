      "body": "<!doctype html>\n<html lang=\"vi\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>MyMiniCloud – Home</title>\n  <link rel=\"stylesheet\" href=\"/style.css\">\n</head>\n<body>\n  <header>\n    <div class=\"header-container\">\n      <a class=\"logo\" href=\"/\">\n        ☁️ MyMiniCloud\n        <span class=\"logo-badge\">9 Servers · Local Stack</span>\n      </a>\n      <nav>\n        <a href=\"/\">Trang chủ</a>\n        <a href=\"/blog/\">Blog</a>\n        <a href=\"#services\">Dịch vụ</a>\n        <a href=\"#demo\">Live Demo</a>\n        <a href=\"#team\">Nhóm</a>\n      </nav>\n    </div>\n  </header>\n\n  <main>\n    <div class=\"hero\">\n      <p class=\"eyebrow\">ĐIỆN TOÁN ĐÁM MÂY · ĐỒ ÁN CUỐI KỲ · 521H0092</p>\n      <h1>MyMiniCloud – Home</h1>\n      <p class=\"intro\">Mô phỏng hạ tầng cloud toàn diện gồm 9 loại server, 13 containers độc lập kết nối qua Docker Network <code>cloud-net</code>, hỗ trợ bảo mật OIDC, giám sát Prometheus/Grafana, cân bằng tải Round Robin và lưu trữ đối tượng MinIO.</p>\n      \n      <div class=\"hero-actions\">\n        <a class=\"button\" href=\"/blog/\">Khám phá Blog →</a>\n        <a class=\"button button-outline\" href=\"/api/student\" target=\"_blank\">Student API (/api/student)</a>\n        <a class=\"button button-outline\" href=\"/lb/whoami\" target=\"_blank\">Load Balancer (/lb/whoami)</a>\n        <a class=\"button button-outline\" href=\"http://localhost:3000/d/system-health-521h0092/system-health-of-521h0092\" target=\"_blank\">Grafana Health</a>\n      </div>\n    </div>\n\n    <!-- 9 Server Grid -->\n    <h2 class=\"section-title\" id=\"services\">Hạ tầng 9 Loại Server Bắt Buộc</h2>\n    <div class=\"grid-servers\">\n      <div class=\"card\">\n        <div class=\"card-header\">\n          <h3 class=\"card-title\">1. Web Frontend</h3>\n          <span class=\"badge badge-green\">Nginx 1.28</span>\n        </div>\n        <p class=\"card-desc\">Cung cấp giao diện web tĩnh, blog 3 bài và proxy metrics cho exporter.</p>\n        <a class=\"card-link\" href=\"/blog/\">Xem Blog (/blog/) →</a>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-header\">\n          <h3 class=\"card-title\">2. Application Backend</h3>\n          <span class=\"badge badge-blue\">Flask 3.11</span>\n        </div>\n        <p class=\"card-desc\">Xử lý logic, API /hello, /student JSON và kết nối cơ sở dữ liệu MariaDB.</p>\n        <a class=\"card-link\" href=\"/api/hello\" target=\"_blank\">Gọi /api/hello →</a>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-header\">\n          <h3 class=\"card-title\">3. Relational Database</h3>\n          <span class=\"badge badge-purple\">MariaDB 11.4</span>\n        </div>\n        <p class=\"card-desc\">Lưu trữ database minicloud.notes và studentdb.students có volume bền vững.</p>\n        <a class=\"card-link\" href=\"/api/students-db\" target=\"_blank\">Xem /api/students-db →</a>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-header\">\n          <h3 class=\"card-title\">4. Authentication Server</h3>\n          <span class=\"badge badge-blue\">Keycloak 26.1</span>\n        </div>\n        <p class=\"card-desc\">Quản lý định danh OIDC, realm realm_521H0092, client flask-app và user sv01/sv02.</p>\n        <a class=\"card-link\" href=\"/auth/\" target=\"_blank\">Keycloak Console →</a>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-header\">\n          <h3 class=\"card-title\">5. Object Storage</h3>\n          <span class=\"badge badge-green\">MinIO Server</span>\n        </div>\n        <p class=\"card-desc\">Lưu trữ S3 bucket: demo, profile-pics (công khai) và documents chứa báo cáo PDF.</p>\n        <a class=\"card-link\" href=\"http://localhost:9001/\" target=\"_blank\">MinIO Console (:9001) →</a>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-header\">\n          <h3 class=\"card-title\">6. Internal DNS</h3>\n          <span class=\"badge badge-purple\">Bind9 9.18</span>\n        </div>\n        <p class=\"card-desc\">Phân giải tên miền cloud.local cho Web, App, MinIO và Keycloak qua cổng 1053/53.</p>\n        <span class=\"card-desc\">zone: cloud.local</span>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-header\">\n          <h3 class=\"card-title\">7. Monitoring Server</h3>\n          <span class=\"badge badge-blue\">Prometheus 3.2</span>\n        </div>\n        <p class=\"card-desc\">Thu thập metrics thời gian thực từ Node Exporter và Web Server (100% UP).</p>\n        <a class=\"card-link\" href=\"http://localhost:9090/targets\" target=\"_blank\">Prometheus Targets →</a>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-header\">\n          <h3 class=\"card-title\">8. Visualization Server</h3>\n          <span class=\"badge badge-green\">Grafana 11.6</span>\n        </div>\n        <p class=\"card-desc\">Hiển thị dashboard System Health of 521H0092 (CPU, Memory, Network traffic).</p>\n        <a class=\"card-link\" href=\"http://localhost:3000/\" target=\"_blank\">Mở Grafana (:3000) →</a>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-header\">\n          <h3 class=\"card-title\">9. Reverse Proxy / Gateway</h3>\n          <span class=\"badge badge-purple\">Nginx Gateway</span>\n        </div>\n        <p class=\"card-desc\">Cổng vào duy nhất port 80, điều phối định tuyến và Round Robin 2 Web server.</p>\n        <a class=\"card-link\" href=\"/healthz\">Gateway /healthz →</a>\n      </div>\n    </div>\n\n    <!-- Live Interactive Demo -->\n    <h2 class=\"section-title\" id=\"demo\">Kiểm Tra Chức Năng Tương Tác</h2>\n    <div class=\"demo-box\">\n      <h3>Dữ Liệu Sinh Viên & Cân Bằng Tải Trực Tuyến</h3>\n      <p class=\"card-desc\">Dữ liệu được nạp trực tiếp qua reverse proxy từ Application Backend và 2 Web instances.</p>\n      \n      <div class=\"demo-controls\">\n        <button class=\"button\" onclick=\"loadStudents()\">Tải danh sách sinh viên (/api/student)</button>\n        <button class=\"button button-outline\" onclick=\"testRoundRobin()\">Gọi Round Robin Load Balancer (/lb/whoami)</button>\n      </div>\n\n      <div class=\"table-wrapper\" id=\"studentTableWrapper\" style=\"display: none;\">\n        <table id=\"studentTable\">\n          <thead>\n            <tr>\n              <th>ID</th>\n              <th>Họ và Tên</th>\n              <th>Ngành Học</th>\n              <th>GPA</th>\n            </tr>\n          </thead>\n          <tbody id=\"studentTbody\"></tbody>\n        </table>\n      </div>\n\n      <div class=\"lb-log\" id=\"lbLog\">Nhấn nút \"Gọi Round Robin Load Balancer\" để kiểm tra luân phiên request giữa web-frontend-server1 và web-frontend-server2...</div>\n    </div>\n\n    <!-- Blog Articles Links -->\n    <section>\n      <h2>Nhật ký triển khai</h2>\n      <ul>\n        <li><a href=\"/blog/blog1.html\">Mạng giữa các dịch vụ</a></li>\n        <li><a href=\"/blog/blog2.html\">Lưu dữ liệu qua vòng đời container</a></li>\n        <li><a href=\"/blog/blog3.html\">Giám sát bằng số liệu</a></li>\n      </ul>\n    </section>\n\n    <!-- Team Members Section -->\n    <section aria-label=\"Thành viên nhóm\" id=\"team\">\n      <h2>Nhóm thực hiện</h2>\n      <div class=\"team-container\">\n        <img class=\"avatar-img\" src=\"http://localhost:9000/profile-pics/avatar.jpg\" alt=\"Avatar Võ Thị Thiên Kim\" onerror=\"this.src='/blog/images/storage.svg'\">\n        <div class=\"team-info\">\n          <p class=\"team-member\">Võ Thị Thiên Kim <span>521H0092</span></p>\n          <p class=\"team-member\">Diệp Yến Nhi <span>MSSV đang bổ sung</span></p>\n        </div>\n      </div>\n    </section>\n\n    <p class=\"footnote\">Nginx · Docker Compose · MyMiniCloud · Kiến trúc đám mây thu nhỏ</p>\n  </main>\n\n  <script>\n    async function loadStudents() {\n      try {\n        const res = await fetch('/api/student');\n        const data = await res.json();\n        const tbody = document.getElementById('studentTbody');\n        tbody.innerHTML = '';\n        data.forEach(s => {\n          const row = document.createElement('tr');\n          row.innerHTML = `<td><code>${s.id}</code></td><td><strong>${s.name}</strong></td><td>${s.major}</td><td><span class=\"badge badge-green\">${s.gpa}</span></td>`;\n          tbody.appendChild(row);\n        });\n        document.getElementById('studentTableWrapper').style.display = 'block';\n      } catch (e) {\n        alert('Lỗi nạp dữ liệu: ' + e);\n      }\n    }\n\n    async function testRoundRobin() {\n      const logBox = document.getElementById('lbLog');\n      try {\n        const res = await fetch('/lb/whoami');\n        const text = await res.text();\n        const header = res.headers.get('x-backend-server') || 'unknown';\n        const timestamp = new Date().toLocaleTimeString();\n        logBox.innerHTML = `[${timestamp}] Phản hồi từ: <strong>${text.trim()}</strong> (X-Backend-Server: ${header})<br>` + logBox.innerHTML;\n      } catch (e) {\n        logBox.innerHTML = `Lỗi gọi /lb/whoami: ${e}<br>` + logBox.innerHTML;\n      }\n    }\n  </script>\n</body>\n</html>\n"
    },
