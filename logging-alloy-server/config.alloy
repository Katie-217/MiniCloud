discovery.docker "minicloud" {
  host = "unix:///var/run/docker.sock"
  filter {
    name = "label"
    values = ["com.docker.compose.project=myminicloud"]
  }
}

discovery.relabel "minicloud" {
  targets = discovery.docker.minicloud.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex = "myminicloud"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
    replacement = "$1"
  }
  rule {
    target_label = "project"
    replacement = "myminicloud"
  }
}

loki.source.docker "minicloud" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.minicloud.output
  labels = {"job" = "docker"}
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://logging-loki-server:3100/loki/api/v1/push"
  }
}
