server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    add_header X-Backend-Server $hostname always;

    location / {
        try_files $uri $uri/ =404;
    }

    location ^~ /blog/ {
        alias /usr/share/nginx/html/blog/;
        index index.html;
        autoindex off;
    }

    location = /whoami {
        default_type text/plain;
        return 200 "Response from $hostname\n";
    }

    location = /stub_status {
        stub_status;
        allow all;
    }

    location = /metrics {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $web_exporter "monitoring-web-exporter-server:9113";
        proxy_pass http://$web_exporter/metrics;
    }
}
